{
  "name": "trepa-indexer",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "rm -rf lib && tsc",
    "start": "node -r dotenv/config lib/main.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate": "npx squid-typeorm-migration apply"
  },
  "dependencies": {
    "@subsquid/batch-processor": "^0.0.0",
    "@subsquid/borsh": "^0.3.0",
    "@subsquid/solana-objects": "^0.0.4",
    "@subsquid/solana-stream": "^0.3.1",
    "@subsquid/typeorm-migration": "^1.3.0",
    "@subsquid/typeorm-store": "^1.5.1",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@subsquid/solana-typegen": "^0.6.1",
    "@types/node": "^22.13.1",
    "typescript": "~5.7.3"
  }
}
