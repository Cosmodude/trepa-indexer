{
  "name": "trepa-indexer",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "rm -rf lib && tsc",
    "prestart": "NODE_OPTIONS=--dns-result-order=ipv6first node src/wait-for-db.mjs && npm run migrate",
    "start": "node lib/main.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate": "npx drizzle-kit push",
    "db:generate": "npx drizzle-kit generate",
    "db:push": "npx drizzle-kit push",
    "db:studio": "npx drizzle-kit studio"
  },
  "dependencies": {
    "@subsquid/batch-processor": "1.0.0-portal-api.a3f844",
    "@subsquid/borsh": "^0.3.0",
    "@subsquid/solana-objects": "0.0.5-portal-api.a3f844",
    "@subsquid/solana-stream": "1.0.0-portal-api.a3f844",
    "@subsquid/typeorm-migration": "^1.3.0",
    "@subsquid/typeorm-store": "1.6.0-portal-api.a3f844",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "pg": "^8.16.3",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@subsquid/solana-typegen": "^0.6.1",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.15.5",
    "dotenv-cli": "^10.0.0",
    "drizzle-kit": "^0.31.5",
    "typescript": "^5.9.3"
  }
}
